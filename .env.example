# Configuration File for Fire Detection Drone System
# Copy this to .env and configure your settings

# ============ FLASK SETTINGS ============
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this
DEBUG=False

# ============ SERVER SETTINGS ============
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
WORKERS=4

# ============ DEVICE SETTINGS ============
# How long device links remain valid (in seconds)
# 3600 = 1 hour, 86400 = 1 day
LINK_EXPIRY_TIME=3600

# Maximum number of connected devices
MAX_DEVICES=50

# ============ FIRE DETECTION SETTINGS ============
# Confidence threshold (0-100) for fire alert
FIRE_CONFIDENCE_THRESHOLD=60

# Detection interval in seconds
DETECTION_INTERVAL=0.3

# How many consecutive detections before confirming fire
CONSECUTIVE_FIRES_THRESHOLD=3

# ============ CAMERA SETTINGS ============
# Use webcam (True) or RTSP stream (False)
USE_WEBCAM=True

# RTSP stream URL (if not using webcam)
RTSP_URL=rtsp://192.168.1.200:554/live/stream

# Camera resolution
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Target FPS
CAMERA_FPS=30

# ============ DRONE/ESP32 SETTINGS ============
# ESP32 IP address for drone control
ESP32_IP=192.168.1.100
ESP32_PORT=80

# ============ SOCKETIO SETTINGS ============
# Enable/disable WebSocket support
SOCKETIO_ENABLED=True

# ============ LOGGING SETTINGS ============
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location
LOG_FILE=logs/fire-drone.log

# ============ SECURITY SETTINGS ============
# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# Enable HTTPS/SSL
ENABLE_HTTPS=False

# SSL certificate path (if HTTPS enabled)
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# ============ DATABASE SETTINGS ============
# For future use if adding database
DATABASE_URL=sqlite:///fire_detection.db

# ============ DEPLOYMENT SETTINGS ============
# Domain name for deployment
DOMAIN_NAME=localhost:5000

# API base URL
API_BASE_URL=http://localhost:5000

# ============ NOTIFICATIONS ============
# Email for alerts (future feature)
ALERT_EMAIL=admin@example.com

# SMS phone number (future feature)
ALERT_PHONE=+1234567890

# Webhook URL for fire alerts
WEBHOOK_URL=https://example.com/webhook

# ============ PERFORMANCE TUNING ============
# Maximum frame queue size
MAX_FRAME_QUEUE=10

# Cleanup interval for expired links (seconds)
CLEANUP_INTERVAL=300

# Frame encoding quality (1-100, higher = better quality but slower)
FRAME_QUALITY=80
